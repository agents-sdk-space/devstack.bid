# Copy to .env.local and fill in. Never commit real keys.
# Server-side only: used by POST /api/plan. Without it, the rule-based planner is used.
# The key needs permission to call the Responses API (scope: api.responses.write).
OPENAI_API_KEY=
# Model for the AI agent (Responses API + Structured Outputs).
OPENAI_MODEL=gpt-6.1-sol

# Public base URL used for Open Graph / Twitter image links (build time). Defaults to the production domain.
# NEXT_PUBLIC_SITE_URL=https://devstack.bid

# Public repository URL (https only) for the docs' "Edit on GitHub" buttons and links to source files.
# Leave unset to hide them, e.g. NEXT_PUBLIC_REPO_URL=https://github.com/<owner>/nvx-stack-builder
# NEXT_PUBLIC_REPO_URL=

# Sign-in. Never commit real values. Callbacks are {origin}/api/auth/<provider>/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cursor Origin app id (public). Register the callback; do not commit a private signing key.
CURSOR_APP_ID=
# Vercel AI Gateway key. Model ids are provider/model strings from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Statsig (feature gates, web analytics, session replay). Public client key; safe to expose.
# Falls back to the built-in key when unset.
NEXT_PUBLIC_STATSIG_CLIENT_KEY=client-QlR7LftVHOC43UqakDi50eSUXEjUfTCL5Di0ZkfBGc6
