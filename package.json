{
  "name": "nvx-stack-builder",
  "version": "0.13.0-rc.3",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-docs.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-docs.mjs && node scripts/build-studio.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "node scripts/build-docs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "node scripts/build-docs.mjs && next typegen",
    "typecheck": "tsc --noEmit",
    "export": "tsx scripts/export-template.ts",
    "cf:build": "node scripts/check-opennext-patch.mjs && opennextjs-cloudflare build && node scripts/check-opennext-patch.mjs --output",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "preview:local": "opennextjs-cloudflare populateCache local && wrangler dev",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply nvx-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nvx-db --remote",
    "db:migrations:list": "wrangler d1 migrations list nvx-db --remote",
    "postinstall": "node scripts/patch-opennext.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:pdf": "node scripts/docs-pdf.mjs",
    "docs:bundle": "node scripts/build-docs.mjs",
    "docs:diagrams": "node scripts/render-diagrams.mjs",
    "studio:brand": "node scripts/sync-studio-brand.mjs",
    "studio:build": "node scripts/build-studio.mjs --force",
    "studio:dev": "npm --prefix studio run dev",
    "studio:check": "node scripts/sync-studio-brand.mjs --check && npm --prefix studio run lint && npm --prefix studio run typecheck && npm --prefix studio test",
    "studio:e2e": "npm --prefix studio run test:e2e",
    "licenses": "node scripts/third-party-licenses.mjs",
    "licenses:check": "node scripts/third-party-licenses.mjs --check",
    "plugins:sync": "node scripts/sync-plugin-catalog.mjs",
    "plugins:check": "node scripts/sync-plugin-catalog.mjs --check",
    "cli:test": "npm --prefix packages/nvx21st test",
    "cf:release-config": "node scripts/gen-release-config.mjs",
    "deploy:hotfix": "npm run cf:build && opennextjs-cloudflare deploy",
    "deploy:release": "node scripts/gen-release-config.mjs && npm run cf:build && opennextjs-cloudflare deploy -c wrangler.release.jsonc",
    "cli:devstack:test": "npm --prefix packages/cli test"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^2.0.93",
    "@statsig/react-bindings": "^3.33.5",
    "@statsig/session-replay": "^3.33.5",
    "@statsig/web-analytics": "^3.33.5",
    "cmdk": "^1.1.1",
    "framer-motion": "^14.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hast-util-to-string": "^3.0.1",
    "jsdom": "^29.1.1",
    "json5": "^2.2.3",
    "lowlight": "^3.3.0",
    "mermaid": "^12.2.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "simple-icons": "^16.34.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
