# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NVX Stack Builder
/out/
*.log
.env*.local
!.env.example

# Generated docs bundle (scripts/build-docs.mjs, rebuilt by prebuild/predev/pretest/pretypecheck)
/src/generated/
/public/docs-search-index.json

# Cloudflare / OpenNext
/.open-next/
/.wrangler/
.dev.vars*
!.dev.vars.example
