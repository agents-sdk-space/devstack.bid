{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production: Workers Custom Domains devstack.bid (apex) + www.devstack.bid (redirects to apex in
  // next.config.ts), approved by the owner on 2026-10-11. workers.dev stays enabled as a fallback.
  // Do not add other routes/domains without approval.
  "name": "nvx-stack-builder",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    { "pattern": "devstack.bid", "custom_domain": true },
    { "pattern": "www.devstack.bid", "custom_domain": true }
  ],
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by OpenNext for cache revalidation; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nvx-stack-builder"
    }
  ],
  // D1 (SQLite) for chat history. Created 2026-10-11 (region WNAM). Schema: migrations/ and
  // docs/reference/d1-schema.md. Apply with `npm run db:migrate:remote` (approval required).
  // R2 binding ASSETS_BUCKET (bucket nvx-assets) is NOT added yet: R2 is not enabled on the account.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nvx-db",
      "database_id": "3ee9bbab-06b5-49da-b175-5f7162ad5086",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-6.1-sol",
    "OPENAI_MAX_OUTPUT_TOKENS": "6000",
    "OPENAI_TIMEOUT_MS": "75000"
  },
  // Workers Rate Limiting API (no separate resource to create; counters are per Cloudflare location).
  // namespace_id is an arbitrary account-unique integer string chosen for this app.
  "ratelimits": [
    {
      // Requests that spend the operator's OpenAI key: 5 per IP per minute.
      "name": "NVX_PLAN_AI_LIMITER",
      "namespace_id": "4711",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // Every POST /api/plan (incl. offline planner / user keys): 20 per IP per minute.
      "name": "NVX_PLAN_LIMITER",
      "namespace_id": "4712",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true
  // Secret (set with `wrangler secret put`, never committed): OPENAI_API_KEY
}
