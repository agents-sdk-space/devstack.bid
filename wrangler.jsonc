{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production: Workers Custom Domains devstack.bid (apex) + www.devstack.bid (redirects to apex in
  // next.config.ts), approved by the owner on 2026-10-11. workers.dev stays enabled as a fallback.
  // Do not add other routes/domains without approval.
  "name": "nvx-stack-builder",
  "main": "custom-worker.ts",
  // custom-worker.ts imports server modules (sweeper) outside Next's bundler; "server-only" is a no-op there.
  "alias": { "server-only": "./node_modules/server-only/empty.js" },
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    { "pattern": "devstack.bid", "custom_domain": true },
    { "pattern": "www.devstack.bid", "custom_domain": true }
  ],
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by OpenNext for cache revalidation; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nvx-stack-builder"
    }
  ],
  // D1 (SQLite) for chat history. Created 2026-10-11 (region WNAM). Schema: migrations/ and
  // docs/reference/d1-schema.md. Apply with `npm run db:migrate:remote` (approval required).
  // R2 bucket for chat stream persistence (streamed text + thinking steps per turn). Owner enabled R2
  // 2026-10-15; the bucket must exist before the next deploy (`wrangler r2 bucket create nvx-chat-streams`).
  "r2_buckets": [
    { "binding": "CHAT_STREAMS", "bucket_name": "nvx-chat-streams" }
  ],
  // Build executor bindings (Containers, Durable Object, Queue, build R2) are NOT here, so a hotfix
  // deploy never needs Docker. They live in release/build-bindings.jsonc and are merged into
  // wrangler.release.jsonc by `npm run cf:release-config` (used by `npm run deploy:release`).
  // CREDENTIALS_KEY (32 random bytes, base64) lives in Cloudflare Secrets Store, not as a Worker secret.
  // Code reads it with `await env.CREDENTIALS_KEY.get()` (src/lib/connections/credentials.ts).
  "secrets_store_secrets": [
    { "binding": "CREDENTIALS_KEY", "store_id": "b56dddabe7d74172932cf26f4a2ab03f", "secret_name": "CREDENTIALS_KEY" }
  ],
  // Workers AI (User Chat on /chat). Always runs remotely, also in `wrangler dev`/preview.
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nvx-db",
      "database_id": "3ee9bbab-06b5-49da-b175-5f7162ad5086",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Turnstile on /login (public site key). The secret is TURNSTILE_SECRET_KEY (wrangler secret).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFXrTVkaNC9mWvUR",
    "TURNSTILE_HOSTNAMES": "devstack.bid",
    "GITHUB_APP_ADMIN_IDS": "326990420",
    "DEVSTACK_ADMIN_GITHUB_IDS": "326990420",
    // Custom domains (Cloudflare for SaaS, see docs/custom-domains.md): set vars SITES_ZONE_ID (devstack.bid zone id)
    // and SITES_CNAME_TARGET (e.g. "sites.devstack.bid") plus secret SITES_SAAS_API_TOKEN (Zone > SSL and Certificates: Edit).
    // Until all three exist the API answers 503 custom_domains_not_configured.
    // Account for per-project server Workers (token: SITES_CF_API_TOKEN secret, Workers Scripts: Edit).
    "SITES_CF_ACCOUNT_ID": "2d92bd5b25768fa9093d6adc0a8887fc",
    "OPENAI_MODEL": "gpt-6.1-sol",
    "OPENAI_MAX_OUTPUT_TOKENS": "6000",
    "OPENAI_TIMEOUT_MS": "75000",
    // /chat (Image and Research Orchestrator). Limits are cost guards for a public page; see
    // docs/reference/config-env.md. CHAT_AGENT_ID empty = inline config from agents/orchestrator/agent.json.
    "CHAT_ENABLED": "true",
    "CHAT_MODEL": "gpt-6.1-sol",
    "CHAT_AGENT_ID": "",
    "CHAT_REASONING_EFFORT": "low",
    "CHAT_ENVIRONMENT": "openai_hosted",
    "CHAT_CONTAINER_SIZE": "small",
    "CHAT_MAX_INPUT_CHARS": "2000",
    "CHAT_MAX_OUTPUT_TOKENS": "2000",
    "CHAT_TURN_TIMEOUT_MS": "180000",
    // Free users (per cookie per day, reset at midnight Asia/Bangkok; per-IP backstop x FREE_IP_MULTIPLIER).
    "FREE_DAILY_MESSAGES": "20",
    "FREE_DAILY_IMAGES": "5",
    "FREE_IP_MULTIPLIER": "3",
    "MAX_ATTACHMENT_BYTES": "10485760",
    // OpenAI Orchestrator agent (server key, ~$30 credit): low caps.
    "CHAT_AGENT_TURNS_PER_DAY": "5",
    "CHAT_GLOBAL_TURNS_PER_DAY": "30",
    "CHAT_AGENT_IMAGES_PER_DAY": "2",
    "CHAT_GLOBAL_IMAGES_PER_DAY": "20",
    // User Chat site-wide daily caps (Workers AI / HF).
    "CHAT_USER_GLOBAL_PER_DAY": "3000",
    "CHAT_USER_GLOBAL_IMAGES_PER_DAY": "500",
    "CHAT_IMAGE_MODEL": "gpt-image-2.5-sunburst",
    "CHAT_IMAGE_QUALITY": "low",
    "CHAT_DAILY_BUDGET_USD": "1",
    // Hugging Face router (HF_TOKEN secret): planner + plain chat. OpenAI server-key fallback off.
    // Workers AI models (User Chat). Verified in the catalog 2026-10-11.
    "WAI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "WAI_THAI_MODEL": "@cf/aisingapore/gemma-sea-lion-v4-27b-it",
    "WAI_CODE_MODEL": "@cf/qwen/qwen2.5-coder-32b-instruct",
    "WAI_IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
    "WAI_MAX_TOKENS": "1500",
    // Cloudflare AI Gateway id for Workers AI calls from /chat and /studio. Empty = off (calls go straight
    // to Workers AI). Set to an existing gateway id, or "default" (Cloudflare creates it on first use), to
    // get logs, analytics and rate limits. Replies are never cached (skipCache). Needs owner approval.
    "CF_AI_GATEWAY_ID": "",
    "HF_MODEL": "deepseek-ai/DeepSeek-V3",
    "HF_FAST_MODEL": "meta-llama/Llama-3.1-8B-Instruct",
    "OPENAI_FALLBACK": "false",
    // /factory (bring your own OpenAI key): anti-abuse only.
    "FACTORY_ENABLED": "true",
    "FACTORY_SESSIONS_PER_HOUR": "10",
    "FACTORY_TURNS_PER_HOUR": "60",
    // /studio (merged DEVSTACK workspace): agents call /api/studio/* -> Workers AI (STUDIO_MODEL),
    // then Hugging Face. Free calls per cookie per day; images share FREE_DAILY_IMAGES with /chat.
    "STUDIO_ENABLED": "true",
    "STUDIO_MODEL": "@cf/qwen/qwen2.5-coder-32b-instruct",
    "STUDIO_PROVIDER": "wai",
    "STUDIO_MAX_TOKENS": "4000",
    "STUDIO_DAILY_CALLS": "60",
    "STUDIO_GLOBAL_CALLS_PER_DAY": "3000",
    "SITES_DNS_READY": "1"
  },
  // Workers Rate Limiting API (no separate resource to create; counters are per Cloudflare location).
  // namespace_id is an arbitrary account-unique integer string chosen for this app.
  "ratelimits": [
    {
      // Requests that spend the operator's OpenAI key: 5 per IP per minute.
      "name": "NVX_PLAN_AI_LIMITER",
      "namespace_id": "4711",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // Every POST /api/plan (incl. offline planner / user keys): 20 per IP per minute.
      "name": "NVX_PLAN_LIMITER",
      "namespace_id": "4712",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      // POST /api/chat/turn burst guard: 4 per IP per minute (hourly/daily limits live in D1).
      "name": "NVX_CHAT_LIMITER",
      "namespace_id": "4713",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      // /api/factory/* (bring-your-own-key) burst guard: 10 per IP per minute.
      "name": "NVX_FACTORY_LIMITER",
      "namespace_id": "4714",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // /api/studio/* burst guard: 20 per IP per minute (one Studio build makes ~3-6 calls).
      "name": "NVX_STUDIO_LIMITER",
      "namespace_id": "4715",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // Build-job sweeper (src/lib/build/sweep.ts): times out stale jobs every 5 minutes. Takes effect only on deploy.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true
  // Secrets (set with `wrangler secret put`, never committed): OPENAI_API_KEY, CHAT_COOKIE_SECRET, HF_TOKEN,
  // GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, CURSOR_APP_ID, AI_GATEWAY_API_KEY
}
