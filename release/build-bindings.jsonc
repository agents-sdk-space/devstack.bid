// Full-release-only bindings for the build executor (docs/platform/BUILD-EXECUTOR.md).
// Merged on top of ../wrangler.jsonc by scripts/gen-release-config.mjs -> wrangler.release.jsonc.
// Deploying these needs Docker (the container image is built from container/Dockerfile).
{
  // Appended to the base r2_buckets. Buckets must exist before deploy.
  "r2_buckets": [
    { "binding": "BUILD_ARTIFACTS", "bucket_name": "devstack-build-artifacts" },
    { "binding": "SITES", "bucket_name": "devstack-sites" }
  ],
  // AI chat builder: Workers KV nvx-stack-builder-kv for rate-limit counters and short caches ONLY (never source data).
  // BLOCKED: set the real namespace id (wrangler kv namespace list) before a full release; deploy fails loudly until then.
  "kv_namespaces": [{ "binding": "KV", "id": "SET_ID_OF_nvx-stack-builder-kv" }],
  "queues": {
    "producers": [{ "binding": "BUILD_QUEUE", "queue": "devstack-build-jobs" }],
    "consumers": [{ "queue": "devstack-build-jobs", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 10, "max_concurrency": 2 }]
  },
  // One container instance per build job; at most 2 at once (also enforced in D1 by claimWithCap).
  "containers": [{ "class_name": "BuildContainer", "image": "./container/Dockerfile", "max_instances": 2, "instance_type": "standard-1" }],
  "durable_objects": { "bindings": [{ "name": "BUILD_CONTAINER", "class_name": "BuildContainer" }] },
  "migrations": [{ "tag": "v1-build-container", "new_sqlite_classes": ["BuildContainer"] }]
}
