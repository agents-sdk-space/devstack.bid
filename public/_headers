# Cloudflare Workers static assets: headers for files served directly from .open-next/assets
# (e.g. /_next/static/*). Page and API responses get the same headers from next.config.ts.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=(), interest-cohort=()

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/docs-assets/diagrams/*
  Cache-Control: public, max-age=31536000, immutable

/docs-search-index.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# /studio (merged DEVSTACK workspace, a Vite SPA built into public/studio by scripts/build-studio.mjs).
# Served straight from static assets, so these headers are the only ones it gets. Cross-origin
# isolation (COOP + COEP) is required by WebContainers (SharedArrayBuffer) and is scoped to /studio
# only: the rest of the site keeps its CSP from next.config.ts and no COEP. Same CSP as the main
# site plus: wasm compile (PGlite), and the StackBlitz/WebContainer frames for the Node sandbox and
# the live preview. Mirrored in src/lib/security-headers.ts (studioContentSecurityPolicy, tested).
/studio/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src https://stackblitz.com https://*.stackblitz.com https://*.webcontainer-api.io https://*.webcontainer.io https://*.staticblitz.com; worker-src 'self' blob:; manifest-src 'self'

/studio/assets/*
  Cache-Control: public, max-age=31536000, immutable

/studio/
  Cache-Control: no-cache
