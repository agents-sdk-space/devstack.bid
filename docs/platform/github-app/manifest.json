{
  "name": "DevStack Deploy",
  "url": "https://devstack.bid",
  "description": "Import repositories into DevStack and deploy them to your Cloudflare account.",
  "public": true,
  "hook_attributes": { "url": "https://devstack.bid/api/github/webhook", "active": true },
  "redirect_url": "https://devstack.bid/api/github/app/manifest-callback",
  "callback_urls": ["https://devstack.bid/api/github/app/callback"],
  "setup_url": "https://devstack.bid/api/github/app/setup",
  "setup_on_update": true,
  "request_oauth_on_install": false,
  "default_permissions": {
    "contents": "read",
    "metadata": "read",
    "pull_requests": "read",
    "deployments": "write",
    "checks": "write"
  },
  "default_events": ["push", "pull_request", "repository"]
}
