  "routes": [
    {
      "path": "/",
      "file": "src/app/page.tsx"
    },
    {
      "path": "/templates",
      "file": "src/app/templates/page.tsx"
    },
    {
      "path": "/templates/[id]",
      "file": "src/app/templates/[id]/page.tsx",
      "notes": "unknown ids return real 404 via next.config.ts rewrite"
    },
    {
      "path": "/builder",
      "file": "src/app/builder/page.tsx",
      "notes": "hash #s=<token> opens Review, #t=<id> opens Configure, #pick opens picker"
    },
    {
      "path": "/design",
      "file": "src/app/design/page.tsx"
    },
    {
      "path": "/docs",
      "file": "src/app/docs/page.tsx",
      "notes": "docs landing rendered from docs/README.md"
    },
    {
      "path": "/docs/[...slug]",
      "file": "src/app/docs/[...slug]/page.tsx",
      "notes": "one page per docs/**/*.md (lower-case path without .md); unknown slugs return real 404 via next.config.ts rewrite"
    },
    {
      "path": "/docs/<slug>.md",
      "file": "src/app/docs/raw/[...slug]/route.ts",
      "notes": "exact raw Markdown, text/markdown; /docs/index.md = docs/README.md; rewritten to /docs/raw/<slug>"
    },
    {
      "path": "/llms.txt",
      "file": "src/app/llms.txt/route.ts",
      "notes": "llmstxt.org index of every raw docs URL"
    },
    {
      "path": "/llms-full.txt",
      "file": "src/app/llms-full.txt/route.ts",
      "notes": "all docs concatenated"
    },
    {
      "path": "/studio/",
      "file": "studio/index.html",
      "notes": "static Vite SPA from public/studio (not a Next.js route); /studio 307 -> /studio/; COOP same-origin + COEP require-corp + Studio CSP only here; link to it with a plain <a> (full page load)"
    }
  ],
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/plan",
      "purpose": "capabilities: whether server AI is available",
      "docs": "docs/reference/api-plan.md"
    },
    {
      "method": "POST",
      "path": "/api/plan",
      "purpose": "prompt -> sanitized plan (ai or fallback)",
      "bodyLimitBytes": 16384,
      "statusCodes": [
        200,
        400,
        413,
        415,
        429
      ],
      "docs": "docs/reference/api-plan.md"
    },
    {
      "method": "GET",
      "path": "/manifest.webmanifest",
      "purpose": "web app manifest (src/app/manifest.ts)"
    },
    {
      "method": "GET",
      "path": "/opengraph-image.png",
      "purpose": "Open Graph card 1200x630"
    },
    {
      "method": "GET",
      "path": "/api/studio/health",
      "purpose": "Studio capabilities (llm/image/provider/model) + this cookie's free quota; issues nvx_chat_uid",
      "docs": "docs/architecture/studio.md"
    },
    {
      "method": "POST",
      "path": "/api/studio/llm/chat",
      "purpose": "Studio agent completion {messages,json?,maxTokens?} -> {content,model}; Workers AI then HF; same-origin only",
      "bodyLimitBytes": 524288,
      "statusCodes": [
        200,
        400,
        403,
        413,
        415,
        429,
        502,
        503
      ],
      "docs": "docs/architecture/studio.md"
    },
    {
      "method": "POST",
      "path": "/api/studio/image",
      "purpose": "Studio DesignAgent image {prompt} -> {dataUrl,model} (FLUX on Workers AI; shares FREE_DAILY_IMAGES with /chat)",
      "bodyLimitBytes": 524288,
      "statusCodes": [
        200,
        400,
        403,
        415,
        429,
        502,
        503
      ],
      "docs": "docs/architecture/studio.md"
    }
  ],
